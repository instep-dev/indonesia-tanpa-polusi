generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Super admin — seeded manually, no self-signup ──────────────────────────

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  accessTokens       SuperAdminAccessToken[]
  refreshTokens      SuperAdminRefreshToken[]
  reviewedArticles   Article[]
  approvedJournalists User[]
}

model SuperAdminAccessToken {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  superAdminId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
}

model SuperAdminRefreshToken {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  superAdminId String
  replacedById String?    @unique
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
}

// ─── Journalist — public self-signup ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  // Self-registered journalists start unapproved — a SuperAdmin must
  // approve the account before its owner can create/submit articles.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   SuperAdmin? @relation(fields: [approvedById], references: [id])

  accessTokens  AccessToken[]
  refreshTokens RefreshToken[]
  articles      Article[]
}

model AccessToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  replacedById String?   @unique
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── CMS: Articles ────────────────────────────────────────────────────────

model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameId    String
  nameEn    String
  createdAt DateTime @default(now())

  articles Article[]
}

model Article {
  id   String @id @default(cuid())
  slug String @unique

  titleId   String
  titleEn   String
  excerptId String
  excerptEn String
  contentId Json
  contentEn Json

  sourceLocale      String
  translationStatus String @default("PENDING")

  coverImage String?

  reportUrl       String?
  pressReleaseUrl String?
  visualUrl       String?

  status          String    @default("DRAFT")
  rejectionReason String?
  publishedAt     DateTime?
  deletedAt       DateTime?

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  reviewedById String?
  reviewedBy   SuperAdmin? @relation(fields: [reviewedById], references: [id])

  images ArticleImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isMain Boolean @default(false)
}

model ArticleImage {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── CMS: Site content ────────────────────────────────────────────────────
// Editable public-site copy/media. One row per field declared in
// data/content-registry.ts; a missing row means "use the built-in default".

model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique
  valueId     String?  @db.Text
  valueEn     String?  @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Repeatable site-content items (stories, contact socials, ...) grouped by
// collection. `data` is validated against the registry for that collection.
model ContentItem {
  id         String    @id @default(cuid())
  collection String
  order      Int       @default(0)
  data       Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([collection, order])
}

// ─── CMS: change history + draft preview ──────────────────────────────────

// One row per CMS change (a field edit, a list-item change, a region rename...),
// written in the same transaction as the change itself. `snapshot` is the state
// AFTER the change, so any revision can be restored. Drafts (status DRAFT) are
// unpublished edits that only show up in preview mode.
model ContentRevision {
  id            String   @id @default(cuid())
  kind          String // 'field' | 'item' | 'collection' | 'region'
  targetKey     String // field key | item id | collection id | region id
  collection    String? // set for items
  status        String   @default("PUBLISHED") // PUBLISHED | DRAFT
  action        String // SAVE | RESET | CREATE | UPDATE | DELETE | REORDER | RESTORE | IMPORT
  snapshot      Json
  createdById   String
  createdByName String // snapshot of the editor's name/email, so it survives account changes
  createdAt     DateTime @default(now())

  @@index([kind, targetKey, createdAt])
  @@index([status, createdAt])
}

// Single-use, short-lived token that lets the super-admin's browser enter
// draft-preview mode on the public site (opaque token, only its hash is stored).
model ContentPreviewToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  superAdminId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
