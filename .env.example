# Copy this file to .env and fill in real values. .env is gitignored.

# --- Docker Postgres (compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=indonesia_tanpa_polusi
POSTGRES_PORT=5432

# --- pgAdmin (compose.yml) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- Prisma ---
# Must match the Postgres credentials above.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indonesia_tanpa_polusi?schema=public

# --- App ---
# Base URL the browser/server should call for API routes.
NEXT_PUBLIC_API=http://localhost:3000/api
NEXT_PUBLIC_API_PORT=3000

CORS_ORIGIN=http://localhost:3000

# --- Cloudflare R2 (image storage for CMS articles) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BUCKET_NAME=
# Custom domain attached to the R2 bucket — do not use the pub-*.r2.dev dev
# URL in production (blocked by Komdigi).
R2_PUBLIC_URL=

# --- Translation (LibreTranslate, self-hosted via compose.yml) ---
# Run `docker compose up -d libretranslate` then point this at it.
# TRANSLATE_API_KEY only needed if LT_API_KEYS is set on the container.
TRANSLATE_API_URL=http://localhost:5001/translate
TRANSLATE_API_KEY=
